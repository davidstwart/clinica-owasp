# ── Entorno ──────────────────────────────────────────────────────────────────
# development | testing | production
ENVIRONMENT=development
DEBUG=False
HABILITAR_DOCS=True
# Interfaz de escucha del servidor embebido (python -m src.main).
# Usa 0.0.0.0 solo si necesitas exponer la API en la red local.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# ── Persistencia ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:CONTRASENA@host:5432/clinica_db

# ── Autenticación (ISO/IEC 27001 A.5.17, A.8.24) ────────────────────────────
# GENERAR: python -c "import secrets; print(secrets.token_urlsafe(48))"
# La aplicación RECHAZA arrancar en producción con un valor de esta lista.
SECRET_KEY=cambiar-por-clave-generada-aleatoriamente-01
ALGORITHM=HS256
JWT_ISSUER=clinica-api
JWT_AUDIENCE=clinica-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

PASSWORD_MIN_LENGTH=8
EXIGIR_MAYUSCULA=True
EXIGIR_MINUSCULA=True
EXIGIR_DIGITO=True
EXIGIR_SIMBOLO=False
EXIGIR_CAMBIO_CONTRASENA_INICIAL=True
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15

# ── Segundo factor (OWASP A07, ISO/IEC 27001 A.5.17) ─────────────────────────
# TOTP obligatorio para cuentas administrativas.
MFA_EXIGIR_ADMIN=True
MFA_TOKEN_EXPIRE_MINUTES=5

# ── Cifrado en reposo (A02 / A.8.24) — AES-256-GCM ──────────────────────────
# GENERAR: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Si queda vacío, la clave se deriva de SECRET_KEY con HKDF (solo para desarrollo).
CIFRADO_CLAVE=

# ── Control de acceso web (A.8.20, A.8.21) ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# A.8.24 — en producción toda petición HTTP se redirige a HTTPS (308).
FORZAR_TLS=True

# ── Limitación de tasa (A.8.6, A.8.16) ───────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_POR_DEFECTO=300/minute

# ── Registro y monitoreo (A.8.15, A.8.16) ───────────────────────────────────
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=1825
